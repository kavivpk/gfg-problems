   1. Missing in Array

class Solution {
    int missingNum(int arr[]) {
        Arrays.sort(arr);
        int n=arr.length;
        for(int i=0;i<n;i++){
            if(arr[i]!=i+1){
                return i+1;
            }
        }
        return n+1;
    }
}

2.Second Largest

class Solution {
    public int getSecondLargest(int[] arr) {
        int larg=-1;
        for(int i=0;i<arr.length;i++){
            if(arr[i]>larg){
                larg=arr[i];
            }
        }
        int sec=-1;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=larg){
                sec=Math.max(sec,arr[i]);
            }
        }
        return sec;
    }
}
